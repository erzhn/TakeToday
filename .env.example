# Скопируйте в .env и заполните. Файл .env в Git не попадает.
DB_URL=jdbc:postgresql://localhost:5433/taketoday
DB_USER=taketoday
DB_PASSWORD=replace_with_local_password
PORT=8080
ADMIN_EMAIL=admin@taketoday.local
ADMIN_PASSWORD=replace_with_strong_password
# Реальная почта (Gmail, пароль приложения). Если не указать — используется локальный Mailpit.
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=app_password
