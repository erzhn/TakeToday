# Скопируйте в .env и заполните. Файл .env в Git не попадает.
DB_URL=jdbc:postgresql://localhost:5433/taketoday
DB_USER=taketoday
DB_PASSWORD=replace_with_local_password
PORT=8080
ADMIN_EMAIL=admin@taketoday.local
ADMIN_PASSWORD=replace_with_strong_password
# Реальная почта (Gmail, пароль приложения). Если не указать — start-backend.ps1 использует локальный Mailpit,
# а при запуске без скрипта (IDEA, mvnw) письма печатаются в консоль.
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=app_password
# true — письма всегда печатаются в консоль приложения, без Mailpit и SMTP
# MAIL_CONSOLE=true

# Показ на защите по https (README, «Запуск по https»): профиль prod и сертификат certs/taketoday.p12
# SPRING_PROFILES_ACTIVE=prod
# PORT=8443
# SSL_KEY_STORE_PASSWORD=replace_with_keystore_password
# SSL_ENABLED=false — если https даёт туннель (cloudflared / ngrok)

# Учебная оплата (этап 3): false — проверить «Платёжная служба временно недоступна»
PAYMENT_MOCK_AVAILABLE=true
# Учебные возвраты (этап 5): false — проверить ручной возврат администратором
PAYMENT_MOCK_REFUNDS_AVAILABLE=true
